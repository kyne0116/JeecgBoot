{
  "project": {
    "path_prefix": "/Users/admin/Work/Github/JeecgBoot"
  },
  "server": {
    "base_url": "http://localhost:8080/jeecg-boot",
    "username": "admin",
    "password": "123456"
  },
  "timeouts": {
    "login": 10,
    "create": 30,
    "list": 15,
    "sync": 30,
    "codegen": 60
  },
  "form": {
    "data_file": "Code_Gen_Guide.json",
    "wait_after_create": 3
  },
  "codegen": {
    "project_path": "{{PROJECT_PATH}}",
    "entity_name": "{{ENTITY_NAME}}",
    "jsp_mode": "one",
    "jform_type": "1",
    "package_style": "service",
    "vue_style": "vue3",
    "code_types": "controller,service,dao,mapper,entity,vue"
  },
  "compilation": {
    "enabled": true,
    "maven_command": "mvn",
    "compile_args": [
      "clean",
      "compile",
      "-DskipTests"
    ],
    "timeout": 300,
    "verify_target_classes": true,
    "auto_create_pom": true,
    "prefer_module_compilation": true
  },
  "query": {
    "page_size": 50,
    "page_no": 1
  },
  "display": {
    "token_length": 50,
    "max_records": 5
  }
}