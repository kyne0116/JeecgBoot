{
  "system_config": {
    "version": "v1.0.0",
    "description": "ContextDev AIGC错误恢复系统配置",
    "updated": "2025-07-27"
  },
  "error_recovery": {
    "max_retry_attempts": 3,
    "base_retry_delay": 1.0,
    "error_recovery_success_threshold": 0.95,
    "enable_exponential_backoff": true,
    "max_retry_delay": 10.0
  },
  "placeholder_patterns": {
    "required": "\\$\\{([A-Z_]+)_REQUIRED\\}",
    "optional": "\\$\\{([A-Z_]+)_OPTIONAL\\}",
    "variable": "\\$\\{([A-Z_]+)\\}",
    "template_variable": "\\$\\{([a-z_]+)\\}"
  },
  "auto_correction_rules": {
    "enable_placeholder_fill": true,
    "enable_type_conversion": true,
    "enable_format_repair": true,
    "enable_field_completion": true,
    "enable_logic_resolution": true,
    "enable_yaml_syntax_fix": true,
    "enable_reference_repair": true
  },
  "error_severity_mapping": {
    "placeholder_error": "low",
    "type_conversion_error": "medium",
    "format_validation_error": "low",
    "missing_field_error": "medium",
    "logic_conflict_error": "high",
    "template_reference_error": "medium",
    "yaml_syntax_error": "high",
    "unknown_error": "high"
  },
  "quality_thresholds": {
    "minimum_recovery_rate": 0.80,
    "maximum_error_rate": 0.05,
    "critical_error_threshold": 3,
    "performance_timeout": 30.0
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": "logs/aigc_error_recovery.log",
    "max_file_size": "10MB",
    "backup_count": 5
  },
  "monitoring": {
    "enable_statistics": true,
    "enable_performance_tracking": true,
    "enable_error_reporting": true,
    "report_export_interval": 3600,
    "metrics_retention_days": 30
  }
}