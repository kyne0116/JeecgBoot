{
  "_comment": "JeecgBoot AI 增强开发配置文件 - Context Engineering + CodeGen 系统专用配置",
  "_version": "4.0.0",
  "_last_updated": "2025-07-25",
  "_configuration_guide": {
    "jeecg_generate_prp": "智能需求文档生成命令配置 - 8+/10质量标准",
    "jeecg_execute_prp": "智能需求文档执行命令配置 - 9+/10质量标准",
    "workflow_presets": "预设工作流，包含完整开发流程",
    "configuration_tips": {
      "complexity_analysis": "simple_crud_indicators vs complex_business_indicators 决定技术路径选择",
      "confidence_thresholds": "generate: 8分, execute: 9分 - 更高标准确保质量",
      "naming_conventions": "严格遵循JeecgBoot规范: us_{module}_{entity}表命名",
      "quality_gates": "多层验证确保企业级标准"
    }
  },
  "project": {
    "name": "JeecgBoot AI Enhanced Development with CodeGen",
    "version": "4.0.0",
    "description": "JeecgBoot项目AI赋能配置（Context Engineering + CodeGen 系统深度集成）",
    "upstream_dependencies": {
      "context-engineering": ">=1.0.0"
    },
    "integration_status": {
      "context_engineering": "完全集成",
      "codegen_system": "深度集成"
    }
  },

  "codegen_integration": {
    "ai_agent_spec": "CodeGen/Code_Gen_Agent.md",
    "execution_script": "CodeGen/Code_Gen_Guide.py",
    "config_template": "CodeGen/Code_Gen_Guide.json",
    "field_templates": "CodeGen/Code_Gen_field_templates.json",
    "automation_level": "full"
  },
  
  "jeecg_specific": {
    "framework": "JeecgBoot",
    "tech_stack": {
      "backend": "Spring Boot + MyBatis-Plus",
      "frontend": "Vue3 + Ant Design Vue",
      "database": "MySQL",
      "cache": "Redis"
    },
    "module_prefix": "jeecg-module",
    "api_base": "http://localhost:8080/jeecg-boot",
    "code_generator": {
      "script": "CodeGen/Code_Gen_Guide.py",
      "config_template": "CodeGen/Code_Gen_Config.json",
      "agent_spec": "CodeGen/Code_Gen_Agent.md"
    },
    "naming_conventions": {
      "table_prefix": "us_",
      "module_format": "jeecg-module-{业务域}",
      "package_format": "org.jeecg.modules.{业务域}",
      "api_format": "/api/{业务域}/{功能}"
    }
  },

  "context_engineering": {
    "enabled": true,
    "version": "latest",
    "templates_path": "ContextDev/templates/",
    "examples_path": "ContextDev/examples/jeecgboot/",
    "workflow": {
      "requirements_template": "REQUIREMENTS_JEECGBOOT.md",
      "design_template": "DESIGN_JEECGBOOT.md",
      "planning_template": "PLANNING_JEECGBOOT.md",
      "testing_template": "TESTING_JEECGBOOT.md",
      "task_template": "TASK_JEECGBOOT.md"
    }
  },

  "commands": {
    "jeecg_generate_prp": {
      "description": "生成JeecgBoot需求文档",
      "template_base": "ContextDev/templates/REQUIREMENTS_JEECGBOOT.md",
      "output_dir": "projectDocs",
      "success_threshold": 8,
      "validation_gates": [
        "technical_feasibility",
        "jeecg_compatibility",
        "codegen_readiness"
      ]
    },
    "jeecg_execute_prp": {
      "description": "执行需求文档并调用CodeGen",
      "codegen_integration": true,
      "success_threshold": 9,
      "validation_gates": [
        "requirements_completeness",
        "codegen_configuration",
        "integration_verification"
      ]
    }
  },

  "workflow_presets": {
    "simple_crud": {
      "description": "简单CRUD功能开发",
      "steps": [
        "jeecg_generate_prp",
        "codegen_execute",
        "integration_test"
      ],
      "complexity_indicators": [
        "single_table",
        "basic_crud",
        "standard_fields"
      ]
    },
    "complex_business": {
      "description": "复杂业务功能开发",
      "steps": [
        "jeecg_generate_prp",
        "design_architecture",
        "codegen_execute",
        "business_logic_implementation",
        "integration_test"
      ],
      "complexity_indicators": [
        "multiple_tables",
        "business_rules",
        "workflow_integration"
      ]
    }
  },

  "quality_gates": {
    "requirements": {
      "completeness_check": true,
      "technical_feasibility": true,
      "jeecg_compatibility": true
    },
    "implementation": {
      "codegen_validation": true,
      "code_quality_check": true,
      "integration_test": true
    },
    "deployment": {
      "functionality_test": true,
      "performance_check": true,
      "security_validation": true
    }
  },

  "documentation": {
    "templates_location": "ContextDev/templates/",
    "examples_location": "ContextDev/examples/jeecgboot/",
    "generated_docs_location": "projectDocs/",
    "auto_update": true
  },

  "development_environment": {
    "required_tools": [
      "Python 3.8+",
      "Git",
      "JDK 17",
      "Node.js 20+",
      "Maven 3.9+"
    ],
    "optional_tools": [
      "VS Code",
      "IDEA"
    ],
    "environment_validation_script": "ContextDev/scripts/validate-integration.sh"
  }
}