{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JeecgBoot在线表单配置Schema",
  "description": "用于验证临时JSON配置文件的结构和内容，防止NullPointerException",
  "type": "object",
  "required": ["head", "fields"],
  "properties": {
    "head": {
      "type": "object",
      "required": [
        "tableName",
        "tableTxt", 
        "tableType",
        "formCategory",
        "idType",
        "isCheckbox",
        "themeTemplate",
        "formTemplate",
        "scroll",
        "isPage",
        "isTree",
        "extConfigJson",
        "isDesForm",
        "desFormCode"
      ],
      "properties": {
        "tableName": {
          "type": "string",
          "pattern": "^us_[a-z]+_[a-z]+_[a-z]+$",
          "description": "表名必须符合us_{模块}_{子模块}_{实体}格式"
        },
        "tableTxt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "表描述不能为空"
        },
        "tableType": {
          "type": "integer",
          "enum": [1],
          "description": "表类型固定为1"
        },
        "formCategory": {
          "type": "string",
          "enum": ["temp", "main"],
          "description": "表单类别"
        },
        "themeTemplate": {
          "type": "string",
          "enum": ["normal"],
          "description": "主题模板"
        },
        "formTemplate": {
          "type": "string",
          "enum": ["1", "2"],
          "description": "表单模板"
        },
        "scroll": {
          "type": "integer",
          "enum": [0, 1],
          "description": "是否滚动"
        },
        "extConfigJson": {
          "type": "string",
          "description": "扩展配置JSON字符串"
        },
        "isDesForm": {
          "type": "string",
          "enum": ["Y", "N"],
          "description": "是否设计表单"
        },
        "desFormCode": {
          "type": "string",
          "description": "设计表单代码"
        },
        "isCheckbox": {
          "type": "string",
          "enum": ["Y", "N"],
          "description": "是否支持复选框"
        },
        "isPage": {
          "type": "string", 
          "enum": ["Y", "N"],
          "description": "是否分页"
        },
        "isTree": {
          "type": "string",
          "enum": ["Y", "N"],
          "description": "是否树形结构"
        },
        "idType": {
          "type": "string",
          "enum": ["UUID", "ASSIGN_ID", "AUTO"],
          "description": "主键类型"
        }
      },
      "additionalProperties": true
    },
    "fields": {
      "type": "array",
      "minItems": 8,
      "description": "字段数组必须至少包含7个系统字段+1个业务字段",
      "items": {
        "type": "object",
        "required": [
          "dbFieldName",
          "dbFieldTxt", 
          "dbType",
          "dbLength",
          "dbIsKey",
          "dbIsNull",
          "dbIsPersist",
          "orderNum",
          "queryShowType",
          "fieldShowType",
          "isShowForm",
          "isShowList",
          "isQuery"
        ],
        "properties": {
          "dbFieldName": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
            "description": "字段名必须以字母开头"
          },
          "dbFieldTxt": {
            "type": "string", 
            "minLength": 1,
            "description": "字段描述不能为空"
          },
          "dbType": {
            "type": "string",
            "enum": [
              "VARCHAR", "string", "int", "BigDecimal", 
              "Date", "Datetime", "text", "LONGTEXT"
            ],
            "description": "数据库字段类型"
          },
          "dbLength": {
            "type": "integer",
            "minimum": 0,
            "description": "字段长度"
          },
          "dbIsKey": {
            "type": "string",
            "enum": ["0", "1"],
            "description": "是否主键"
          },
          "dbIsNull": {
            "type": "string", 
            "enum": ["0", "1"],
            "description": "是否允许为空"
          },
          "dbIsPersist": {
            "type": "string",
            "enum": ["0", "1"],
            "description": "是否持久化"
          },
          "orderNum": {
            "type": "integer",
            "minimum": 0,
            "description": "字段排序号"
          },
          "fieldShowType": {
            "type": "string",
            "description": "字段显示类型"
          },
          "isShowForm": {
            "type": "string",
            "enum": ["0", "1"],
            "description": "是否在表单中显示"
          },
          "isShowList": {
            "type": "string", 
            "enum": ["0", "1"],
            "description": "是否在列表中显示"
          },
          "isQuery": {
            "type": "string",
            "enum": ["0", "1"], 
            "description": "是否可查询"
          },
          "queryShowType": {
            "type": "string",
            "description": "查询显示类型"
          }
        },
        "additionalProperties": true
      }
    },
    "indexs": {
      "type": "array",
      "description": "索引数组"
    },
    "deleteFieldIds": {
      "type": "array",
      "description": "删除字段ID数组"
    },
    "deleteIndexIds": {
      "type": "array",
      "description": "删除索引ID数组"
    }
  },
  "additionalProperties": false
}
