{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JeecgBoot配置Schema(简化版)",
  "description": "验证JSON配置文件核心结构",
  "type": "object",
  "required": ["head", "fields", "indexs", "deleteFieldIds", "deleteIndexIds"],
  "properties": {
    "head": {
      "type": "object",
      "required": ["tableName", "tableTxt", "business_entity", "tableType", "formCategory"],
      "properties": {
        "tableName": {
          "type": "string",
          "pattern": "^us_[a-z]+_[a-z]+_[a-z]+$"
        },
        "tableTxt": {
          "type": "string",
          "minLength": 1
        },
        "business_entity": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z]*$"
        },
        "tableType": {
          "type": "integer",
          "enum": [1]
        },
        "formCategory": {
          "type": "string",
          "enum": ["temp"]
        }
      },
      "additionalProperties": true
    },
    "fields": {
      "type": "array",
      "minItems": 8,
      "description": "字段数组，orderNum必须从0开始连续递增",
      "items": {
        "type": "object",
        "required": ["dbFieldName", "dbFieldTxt", "dbType", "orderNum"],
        "properties": {
          "dbFieldName": {
            "type": "string",
            "minLength": 1
          },
          "dbFieldTxt": {
            "type": "string",
            "minLength": 1
          },
          "dbType": {
            "type": "string",
            "enum": ["string", "int", "BigDecimal", "Date", "Datetime", "text"]
          },
          "orderNum": {
            "type": "integer",
            "minimum": 0,
            "description": "必须从0开始严格连续递增"
          }
        },
        "additionalProperties": true
      }
    },
    "indexs": {
      "type": "array"
    },
    "deleteFieldIds": {
      "type": "array"
    },
    "deleteIndexIds": {
      "type": "array"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generation_info": {
          "type": "object",
          "required": ["module_name", "submodule_name", "business_entity"]
        },
        "derived_formats": {
          "type": "object",
          "required": ["table_suffix", "url_path", "frontend_path"]
        }
      }
    }
  },
  "additionalProperties": true
}
