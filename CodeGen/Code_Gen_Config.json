{
  "project": {
    "path_prefix": "$JEECG_PROJECT_ROOT"
  },
  "server": {
    "base_url": "$JEECG_BASE_URL",
    "username": "$JEECG_USERNAME",
    "password": "$JEECG_PASSWORD"
  },
  "timeouts": {
    "login": 10,
    "create": 30,
    "list": 15,
    "sync": 30,
    "codegen": 60
  },
  "form": {
    "data_file": "Code_Gen_Guide.json",
    "wait_after_create": 3
  },
  "codegen": {
    "project_path": "{{PROJECT_PATH}}",
    "entity_name": "{{BUSINESS_ENTITY}}",
    "jsp_mode": "one",
    "jform_type": "1",
    "package_style": "service",
    "vue_style": "vue3",
    "code_types": "controller,service,dao,mapper,entity,vue",
    "table_types": {
      "single": {
        "tableType": 1,
        "relationType": null,
        "tabOrderNum": null,
        "jsp_mode": "one",
        "jform_type": "1",
        "description": "独立表配置"
      },
      "main": {
        "tableType": 2,
        "relationType": null,
        "tabOrderNum": null,
        "jsp_mode": "jvxe",
        "jform_type": "2",
        "enable_sub_list": true,
        "description": "主表配置"
      },
      "sub": {
        "tableType": 3,
        "relationType": 0,
        "tabOrderNum": "{{AUTO_INCREMENT}}",
        "jsp_mode": "one",
        "jform_type": "1",
        "description": "子表配置"
      }
    },
    "master_sub_table": {
      "jsp_mode": "jvxe",
      "jform_type": "2",
      "enable_sub_list": true,
      "sub_id_start": 1020,
      "sub_id_prefix": "row_",
      "foreign_key_suffix": "_id",
      "tab_order_start": 1
    }
  },
  "compilation": {
    "enabled": false,
    "strategy": "skip",
    "reason": "编译不影响代码生成核心功能，跳过以提高效率",
    "maven_command": "mvn",
    "compile_args": [
      "compile",
      "-DskipTests"
    ],
    "timeout": 120,
    "verify_target_classes": false,
    "auto_create_pom": true,
    "prefer_module_compilation": true,
    "fallback_options": {
      "quick_compile": {
        "enabled": false,
        "command": ["mvn", "compile", "-DskipTests"],
        "timeout": 120
      },
      "full_install": {
        "enabled": false,
        "command": ["mvn", "clean", "install", "-DskipTests"],
        "timeout": 300
      }
    }
  },
  "frontend_migration": {
    "enabled": true,
    "target_base_path": "jeecgboot-vue3/src/views",
    "cleanup_source": false,
    "create_target_dirs": true
  },
  "database_execution": {
    "enabled": true,
    "method": "mysql_client",
    "timeout": 30,
    "auto_commit": true,
    "config_file_path": "jeecg-boot/jeecg-module-system/jeecg-system-start/src/main/resources/application-dev.yml"
  },
  "permission_authorization": {
    "enabled": true,
    "admin_role_id": "f6817f48af4fb3af11b9e8bf182f618b",
    "timeout": 30,
    "retry_attempts": 3,
    "auto_grant_to_admin": true,
    "description": "自动为管理员角色授权新生成模块的权限"
  },
  "query": {
    "page_size": 50,
    "page_no": 1
  },
  "display": {
    "token_length": 50,
    "max_records": 5
  }
}