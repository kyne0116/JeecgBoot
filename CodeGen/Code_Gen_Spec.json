          "dbIsPersist": "1",
          "fieldShowType": "datetime",
          "isShowForm": "0",
          "isShowList": "0",
          "orderNum": 2,
          "_orderNum_constraint": "系统字段创建时间，orderNum固定为2"
        },
        {
          "_field_type": "system_field",
          "_field_index": 3,
          "dbFieldName": "update_by",
          "dbFieldTxt": "更新人",
          "dbType": "string",
