      "_ai_instruction": "以下7个系统字段必须完全复制，不能修改",
      "_orderNum_constraint": "系统字段orderNum必须0-6连续，不能跳号",

      "fields": [
        {
          "_field_type": "system_field",
          "_field_index": 0,
          "dbFieldName": "id",
          "dbFieldTxt": "主键",
          "dbType": "string",
          "dbLength": 36,
          "dbIsNull": "0",
          "dbIsPersist": "1",
          "fieldShowType": "text",
          "isShowForm": "0",
          "isShowList": "0",
          "orderNum": 0,
          "_orderNum_constraint": "系统字段ID，orderNum固定为0"
        },
        {
          "_field_type": "system_field",
          "_field_index": 1,
          "dbFieldName": "create_by",
          "dbFieldTxt": "创建人",
