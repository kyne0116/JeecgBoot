          "dbIsNull": "1",
          "dbIsPersist": "1",
          "fieldShowType": "text",
          "isShowForm": "0",
          "isShowList": "0",
          "orderNum": 5,
          "_orderNum_constraint": "系统字段组织编码，orderNum固定为5"
