    "business_field_template": {
      "_description": "业务字段模板",
      "_ai_instruction": "业务字段从orderNum=7开始，必须连续递增",
      "_orderNum_start": 7,
      "_orderNum_constraint": "业务字段orderNum从7开始连续递增，不能跳号",

      "template": {
        "_field_type": "business_field",
        "dbFieldName": "{{FIELD_NAME}}",
        "_dbFieldName_type": "string",
        "_dbFieldName_pattern": "^[a-z][a-z0-9_]*$",
        "_dbFieldName_ai_hint": "字段名，小写字母开头，可包含数字和下划线",

        "dbFieldTxt": "{{FIELD_DESCRIPTION}}",
        "_dbFieldTxt_type": "string",
        "_dbFieldTxt_ai_hint": "字段中文描述，如'客户姓名'、'发票金额'",

        "dbType": "{{FIELD_TYPE}}",
        "_dbType_type": "string",
        "_dbType_enum": ["string", "int", "BigDecimal", "Date", "Datetime", "text"],
        "_dbType_ai_hint": "字段数据类型，常用string、int、BigDecimal、Date",

        "dbLength": "{{FIELD_LENGTH}}",
        "_dbLength_type": "integer",
        "_dbLength_default": 100,
        "_dbLength_ai_hint": "字段长度，string类型常用100，int类型可省略",

        "dbIsNull": "1",
        "_dbIsNull_type": "string",
        "_dbIsNull_enum": ["0", "1"],
        "_dbIsNull_ai_hint": "是否可空：0=不可空，1=可空，业务字段通常为1",

        "dbIsPersist": "1",
        "_dbIsPersist_type": "string",
        "_dbIsPersist_constraint": "必须为1，表示字段持久化到数据库",

        "fieldShowType": "{{SHOW_TYPE}}",
        "_fieldShowType_type": "string",
        "_fieldShowType_max_length": 20,
        "_fieldShowType_enum": ["text", "textarea", "number", "date", "select", "radio", "checkbox"],
        "_fieldShowType_ai_hint": "显示类型，最大20字符，常用text、select、date",

        "isShowForm": "1",
        "_isShowForm_type": "string",
        "_isShowForm_enum": ["0", "1"],
        "_isShowForm_ai_hint": "是否在表单中显示：0=不显示，1=显示",

        "isShowList": "1",
        "_isShowList_type": "string",
        "_isShowList_enum": ["0", "1"],
        "_isShowList_ai_hint": "是否在列表中显示：0=不显示，1=显示",

        "queryMode": "{{QUERY_MODE}}",
        "_queryMode_type": "string",
        "_queryMode_max_length": 10,
        "_queryMode_enum": ["single", "range", "like", "in", "between"],
        "_queryMode_ai_hint": "查询模式，最大10字符，推荐single/range/like",
        "_queryMode_constraint": "禁用group_range、date_range等超长值",

        "orderNum": "{{ORDER_NUM}}",
        "_orderNum_type": "integer",
        "_orderNum_start": 7,
        "_orderNum_constraint": "从7开始连续递增，不能跳号",
        "_orderNum_ai_hint": "字段排序号，从7开始：7,8,9,10..."
      }
    }
  },

  "metadata_structure": {
    "_description": "元数据结构定义",

    "generation_info": {
      "module_name": "{{MODULE_NAME}}",
      "_module_name_type": "string",
      "_module_name_format": "lowercase",
      "_module_name_ai_hint": "业务系统模块名，如finance、hrms、crm",

      "submodule_name": "{{SUBMODULE_NAME}}",
      "_submodule_name_type": "string",
      "_submodule_name_format": "lowercase",
      "_submodule_name_ai_hint": "功能子模块名，如invoice、employee、customer",

      "business_entity": "{{BUSINESS_ENTITY}}",
      "_business_entity_type": "string",
      "_business_entity_format": "PascalCase",
      "_business_entity_ai_hint": "核心业务实体，如CustomerProfile、InvoiceInfo",

      "inference_strategy": "{{INFERENCE_STRATEGY}}",
      "_inference_strategy_ai_hint": "AI推理策略说明，记录推理过程",

      "semantic_analysis": "{{SEMANTIC_ANALYSIS}}",
      "_semantic_analysis_ai_hint": "语义分析结果，记录业务理解"
    },

    "derived_formats": {
      "table_suffix": "{{TABLE_SUFFIX}}",
      "_table_suffix_derivation": "BUSINESS_ENTITY转为全小写",

      "url_path": "{{URL_PATH}}",
      "_url_path_derivation": "BUSINESS_ENTITY转为kebab-case",

      "frontend_path": "{{FRONTEND_PATH}}",
      "_frontend_path_derivation": "MODULE_NAME/TABLE_SUFFIX",

      "package_name": "{{PACKAGE_NAME}}",
      "_package_name_derivation": "org.jeecg.modules.MODULE_NAME.SUBMODULE_NAME"
    }
  },

  "validation_rules": {
    "_description": "配置文件验证规则",

    "critical_constraints": {
      "_description": "致命约束，违反将导致API失败",

      "orderNum_continuity": {
        "rule": "orderNum必须从0开始严格连续递增",
        "pattern": "^(0|[1-9][0-9]*)$",
        "validation": "检查是否存在跳号：0,1,2,3,4...",
        "error_example": "❌ 0,1,2,5,6 (跳过3,4)",
        "correct_example": "✅ 0,1,2,3,4 (严格连续)",
        "_ai_hint": "这是JeecgBoot API的强制要求，违反会导致API调用失败"
      },

      "system_fields_integrity": {
        "rule": "前7个字段必须是标准系统字段",
        "required_fields": ["id", "create_by", "create_time", "update_by", "update_time", "sys_org_code", "del_flag"],
        "required_orderNums": [0, 1, 2, 3, 4, 5, 6],
        "_ai_hint": "系统字段配置不能修改，必须完全复制模板"
      },

      "table_name_format": {
        "rule": "表名必须符合4段式格式",
        "pattern": "^us_[a-z]+_[a-z]+_[a-z]+$",
        "format": "us_{MODULE_NAME}_{SUBMODULE_NAME}_{TABLE_SUFFIX}",
        "error_example": "❌ us_finance_invoice (只有3段)",
        "correct_example": "✅ us_finance_invoice_customerprofile (4段)",
        "_ai_hint": "表名格式是JeecgBoot的强制要求"
      }
    },

    "field_length_limits": {
      "_description": "字段长度限制，基于JeecgBoot数据库表结构",

      "queryMode": {
        "max_length": 10,
        "recommended_values": ["single", "range", "like", "in", "between"],
        "forbidden_values": ["group_range", "date_range", "multi_select"],
        "auto_correction": {
          "group_range": "range",
          "date_range": "range",
          "multi_select": "single"
        },
        "_ai_hint": "queryMode最大10字符，超长值会被自动修正"
      },

      "fieldShowType": {
        "max_length": 20,
        "recommended_values": ["text", "textarea", "number", "date", "select", "radio", "checkbox"],
        "_ai_hint": "fieldShowType最大20字符"
      },

      "queryShowType": {
        "max_length": 50,
        "recommended_values": ["text", "date", "select", "number"],
        "_ai_hint": "queryShowType最大50字符，通常不会超限"
      },

      "fieldValidType": {
        "max_length": 300,
        "recommended_values": ["mobile", "email", "n,p", "url"],
        "_ai_hint": "fieldValidType最大300字符，通常不会超限"
      }
    },

    "business_rules": {
      "_description": "业务规则验证",

      "entity_naming": {
        "rule": "BUSINESS_ENTITY必须具体化，避免通用词汇",
        "forbidden_patterns": ["Management", "Info", "Data", "System"],
        "recommended_patterns": ["Profile", "Record", "Detail", "Config"],
        "examples": {
          "bad": ["CustomerManagement", "UserInfo", "ProductData"],
          "good": ["CustomerProfile", "UserRecord", "ProductDetail"]
        },
        "_ai_hint": "使用具体的业务实体名，避免Management等通用词"
      },

      "module_consistency": {
        "rule": "主子表必须属于同一模块",
        "validation": "主表和所有子表的MODULE_NAME和SUBMODULE_NAME必须一致",
        "_ai_hint": "主子表关联时，所有表必须在同一业务模块下"
      }
    }
  },

  "api_integration": {
    "_description": "JeecgBoot API集成配置",

    "request_structure": {
      "_description": "API请求结构定义",

      "addAll_request": {
        "method": "POST",
        "path": "/online/cgform/api/addAll",
        "content_type": "application/json",
        "required_fields": ["head", "fields"],
        "optional_fields": ["subList", "metadata", "indexs", "deleteFieldIds", "deleteIndexIds"],
        "body_structure": {
          "head": "表基本信息对象",
          "fields": "字段定义数组",
          "subList": "子表配置数组(主表场景)",
          "metadata": "元数据信息对象",
          "indexs": "索引配置数组",
          "deleteFieldIds": "删除字段ID数组",
          "deleteIndexIds": "删除索引ID数组"
        }
      },

      "codeGenerate_request": {
        "method": "POST",
        "path": "/online/cgform/api/codeGenerate",
        "content_type": "application/json",
        "required_fields": ["id", "projectPath", "entityName"],
        "optional_fields": ["subList", "jspMode", "jformType"],
        "body_structure": {
          "id": "表单ID",
          "projectPath": "项目路径",
          "entityName": "实体名称",
          "subList": "子表列表(主表场景)",
          "jspMode": "JSP模式(one/jvxe)",
