{
  "_schema_info": {
    "version": "3.0",
    "title": "JeecgBoot 代码生成系统 - 增强JSON配置规范",
    "description": "基于AI友好设计的完整配置规范，支持独立表和主子表场景",
    "compatible_versions": ["JeecgBoot 3.8.2+"],
    "last_updated": "2025-01-04",
    "specification_type": "enhanced_json"
  },

  "_ai_generation_context": {
    "template_type": "enhanced_json_with_ai_hints",
    "validation_level": "strict",
    "error_prevention_strategy": "constraint_driven",
    "ai_guidance": {
      "variable_inference": "从用户业务需求中推断三核心变量",
      "entity_extraction": "提取最核心的业务实体作为BUSINESS_ENTITY",
      "field_generation": "确保orderNum从0开始严格连续递增",
      "constraint_compliance": "严格遵守字段长度和格式约束",
      "scenario_detection": "自动识别独立表vs主子表场景"
    },
    "common_pitfalls": {
      "orderNum_discontinuity": "orderNum必须连续，不能跳号",
      "field_length_overflow": "queryMode≤10字符，fieldShowType≤20字符",
      "table_name_format": "必须符合us_{module}_{submodule}_{entity}格式",
      "system_fields_missing": "前7个字段必须是标准系统字段"
    }
  },

  "core_variables": {
    "_description": "三核心变量系统定义",
    "MODULE_NAME": {
      "value": "{{MODULE_NAME}}",
      "_type": "string",
      "_format": "lowercase",
      "_pattern": "^[a-z]+$",
      "_ai_hint": "业务系统模块名，如finance、hrms、crm、education",
      "_examples": ["finance", "hrms", "crm", "education", "inventory"],
      "_derivation_source": "从用户业务需求推断"
    },
    "SUBMODULE_NAME": {
      "value": "{{SUBMODULE_NAME}}",
      "_type": "string", 
      "_format": "lowercase",
      "_pattern": "^[a-z]+$",
      "_ai_hint": "功能子模块名，如invoice、employee、customer、student",
      "_examples": ["invoice", "employee", "customer", "student", "product"],
      "_derivation_source": "从业务功能领域推断"
    },
    "BUSINESS_ENTITY": {
      "value": "{{BUSINESS_ENTITY}}",
      "_type": "string",
      "_format": "PascalCase", 
      "_pattern": "^[A-Z][a-zA-Z]*$",
      "_ai_hint": "核心业务实体名，如CustomerProfile、InvoiceInfo、EmployeeRecord",
      "_examples": ["CustomerProfile", "InvoiceInfo", "EmployeeRecord", "StudentInfo"],
      "_derivation_source": "从具体业务对象提取",
      "_constraint": "避免使用Management、Info等通用词汇，要具体化"
    }
  },

  "derived_formats": {
    "_description": "从核心变量自动派生的格式",
    "TABLE_SUFFIX": {
      "value": "{{TABLE_SUFFIX}}",
      "_derivation": "BUSINESS_ENTITY转为全小写连续字符",
      "_transformation": "PascalCase → lowercase",
      "_example": "CustomerProfile → customerprofile"
    },
    "URL_PATH": {
      "value": "{{URL_PATH}}",
      "_derivation": "BUSINESS_ENTITY转为kebab-case格式",
      "_transformation": "PascalCase → kebab-case",
      "_example": "CustomerProfile → customer-profile"
    },
    "FRONTEND_PATH": {
      "value": "{{FRONTEND_PATH}}",
      "_derivation": "MODULE_NAME/TABLE_SUFFIX路径格式",
      "_transformation": "组合路径",
      "_example": "finance/customerprofile"
    },
    "PACKAGE_NAME": {
      "value": "org.jeecg.modules.{{MODULE_NAME}}.{{SUBMODULE_NAME}}",
      "_derivation": "标准Java包名格式",
      "_transformation": "固定前缀+模块路径",
      "_example": "org.jeecg.modules.finance.invoice"
    }
  },

  "scenarios": {
    "_description": "不同场景的配置模板",
    
    "independent_table": {
      "_scenario_type": "独立表",
      "_api_strategy": "full_workflow",
      "_description": "独立业务表，无关联关系",
      
      "head": {
        "tableName": "us_{{MODULE_NAME}}_{{SUBMODULE_NAME}}_{{TABLE_SUFFIX}}",
        "_tableName_type": "string",
        "_tableName_pattern": "^us_[a-z]+_[a-z]+_[a-z]+$",
        "_tableName_ai_hint": "4段式命名：us_模块_子模块_实体，全小写下划线分隔",
        
        "tableTxt": "{{BUSINESS_DESCRIPTION}}",
        "_tableTxt_type": "string",
        "_tableTxt_ai_hint": "业务功能描述，如'客户档案信息'、'发票管理信息'",
        
        "business_entity": "{{BUSINESS_ENTITY}}",
        "_business_entity_type": "string",
        "_business_entity_format": "PascalCase",
        "_business_entity_ai_hint": "核心业务实体，避免使用Management等通用词",
        
        "tableType": 1,
        "_tableType_type": "integer",
        "_tableType_enum": [1, 2, 3],
        "_tableType_ai_hint": "1=独立表, 2=主表, 3=子表",
        "_tableType_constraint": "独立表场景固定为1",
        
        "relationType": null,
        "_relationType_ai_hint": "独立表无关联关系，固定为null",
        
        "tabOrderNum": null,
        "_tabOrderNum_ai_hint": "独立表不需要排序，固定为null",
        
        "formCategory": "temp",
        "idType": "UUID",
        "isCheckbox": "Y",
        "themeTemplate": "normal",
        "formTemplate": "1",
        "scroll": 1,
        "isPage": "Y",
        "isTree": "N",
        "isDesForm": "N",
        "desFormCode": ""
      },
      
      "subList": [],
      "_subList_ai_hint": "独立表场景subList为空数组"
    },

    "main_table": {
      "_scenario_type": "主表",
      "_api_strategy": "main_table_workflow", 
      "_description": "主子表关系中的主表，包含subList配置",
      
      "head": {
        "tableName": "us_{{MODULE_NAME}}_{{SUBMODULE_NAME}}_{{TABLE_SUFFIX}}",
        "tableTxt": "{{BUSINESS_DESCRIPTION}}",
        "business_entity": "{{BUSINESS_ENTITY}}",
        
        "tableType": 2,
        "_tableType_constraint": "主表场景固定为2",
        
        "relationType": null,
        "_relationType_ai_hint": "主表无关联关系，固定为null",
        
        "tabOrderNum": null,
        "_tabOrderNum_ai_hint": "主表不需要排序，固定为null",
        
        "subTableStr": "{{SUB_TABLE_LIST}}",
        "_subTableStr_type": "string",
        "_subTableStr_format": "逗号分隔的子表名列表",
        "_subTableStr_ai_hint": "子表表名列表，如'us_education_student_parents,us_education_student_classmate'",
        
        "formCategory": "temp",
        "idType": "UUID", 
        "isCheckbox": "Y",
        "themeTemplate": "normal",
        "formTemplate": "1",
        "scroll": 1,
        "isPage": "Y",
        "isTree": "N",
        "isDesForm": "N",
        "desFormCode": ""
      },
      
      "subList": [
        {
          "_subList_template": "子表配置模板",
          "tableName": "us_{{MODULE_NAME}}_{{SUBMODULE_NAME}}_{{SUB_TABLE_SUFFIX}}",
          "_tableName_ai_hint": "子表表名，必须与主表同模块",
          
          "entityName": "{{SUB_ENTITY_NAME}}",
          "_entityName_type": "string",
          "_entityName_format": "PascalCase",
          "_entityName_ai_hint": "子表实体名，如StudentParents、StudentClassmate",
          
          "ftlDescription": "{{SUB_TABLE_DESCRIPTION}}",
          "_ftlDescription_type": "string",
          "_ftlDescription_ai_hint": "子表业务描述，如'学生家长信息表'",
          
          "id": "row_{{SUB_ID}}",
          "_id_type": "string",
          "_id_pattern": "^row_[0-9]{4}$",
          "_id_start_value": "row_1020",
          "_id_increment_rule": "从row_1020开始递增：row_1020, row_1021, row_1022...",
          "_id_ai_hint": "子表ID，从row_1020开始递增"
        }
      ]
    },

    "sub_table": {
      "_scenario_type": "子表",
      "_api_strategy": "sub_table_workflow",
      "_description": "主子表关系中的子表，只创建数据库表不生成代码",
      
      "head": {
        "tableName": "us_{{MODULE_NAME}}_{{SUBMODULE_NAME}}_{{TABLE_SUFFIX}}",
        "tableTxt": "{{BUSINESS_DESCRIPTION}}",
        "business_entity": "{{BUSINESS_ENTITY}}",
        
        "tableType": 3,
        "_tableType_constraint": "子表场景固定为3",
        
        "relationType": 0,
        "_relationType_type": "integer",
        "_relationType_constraint": "子表一对多关系固定为0",
        "_relationType_ai_hint": "0=一对多关系(1:N)",
        
        "tabOrderNum": "{{TAB_ORDER}}",
        "_tabOrderNum_type": "integer",
        "_tabOrderNum_start_value": 1,
        "_tabOrderNum_ai_hint": "子表显示顺序，从1开始递增：1,2,3...",
        
        "formCategory": "temp",
        "idType": "UUID",
        "isCheckbox": "Y", 
        "themeTemplate": "normal",
        "formTemplate": "1",
        "scroll": 1,
        "isPage": "Y",
        "isTree": "N",
        "isDesForm": "N",
        "desFormCode": ""
      },
      
      "subList": [],
      "_subList_ai_hint": "子表场景subList为空数组"
    }
  },

